a, b, c = input().split()
a = float (a)
b = float (b)
c = float (c)

pi = 3.14159

triangulo = (a * c) / 2
circulo = c * c * pi
trapezio = ((a + b) * c) / 2
quadrado = b * b
retangulo = a * b 

print (
    f"TRIANGULO: {triangulo:.3f}\n"
    f"CIRCULO: {circulo:.3f}\n"
    f"TRAPEZIO: {trapezio:.3f}\n"
    f"QUADRADO: {quadrado:.3f}\n"
    f"RETANGULO: {retangulo:.3f}"
)
